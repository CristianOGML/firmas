<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_send_request_view_form_personal_copy" model="ir.ui.view">
        <field name="name">sign.send.request.form.personal.copy</field>
        <field name="model">sign.send.request</field>
        <field name="inherit_id" ref="sign.sign_send_request_view_form"/>
        <field name="arch" type="xml">
            <!-- Apuntamos a la lista de firmantes y nos ponemos después del contacto -->
            <xpath expr="//field[@name='signer_ids']/list/field[@name='partner_id']" position="after">
                <!-- Campo oculto para saber si es empleado -->
                <field name="is_employee" column_invisible="1"/>
                <!-- El check que verá el usuario (solo si is_employee es True) -->
                <field name="cc_personal_email" invisible="not is_employee"/>
            </xpath>
        </field>
    </record>
</odoo>